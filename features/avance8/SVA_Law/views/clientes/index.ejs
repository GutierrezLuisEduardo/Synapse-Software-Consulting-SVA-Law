<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="clientes-header mb-4">
                    <h1 class="page-title">Clientes</h1>
                    <form method="GET" action="/clientes">
                        <input type="text" name="search" class="form-control buscador"
                            placeholder="Buscar por nombre o ID" value="<%= search %>">
                    </form>
                </div>

                <div class="table-responsive tabla-container">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Tipo Persona</th>
                                <th>Fecha Alta</th>
                                <th>Expediente</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (clientes.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center py-4">No se encontraron clientes</td>
                                </tr>
                            <% } %>
                            <% clientes.forEach(cliente => { %>
                                <tr class="fila-cliente" onclick="window.location='/clientes/<%= cliente.cliente_id %>'">
                                    <td><%= cliente.cliente_id %></td>
                                    <td><%= cliente.nombre_cliente %></td>
                                    <td><%= cliente.tipo_persona || '—' %></td>
                                    <td><%= new Date(cliente.fecha_creacion).toLocaleDateString('es-MX') %></td>
                                    <td><span class="badge-expediente">Ver expediente</span></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="pagination-container mt-4">
                    <div class="d-flex gap-2 align-items-center">
                        <% if (currentPage > 1) { %>
                            <a class="btn btn-pagination" href="/clientes?page=<%= currentPage - 1 %>&search=<%= search %>">Anterior</a>
                        <% } %>
                        <span class="page-indicator">Página <%= currentPage %> de <%= totalPages || 1 %></span>
                        <% if (currentPage < totalPages) { %>
                            <a class="btn btn-pagination" href="/clientes?page=<%= currentPage + 1 %>&search=<%= search %>">Siguiente</a>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>
    </body>
</html>