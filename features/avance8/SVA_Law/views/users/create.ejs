<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head.ejs') %>
        <link rel="stylesheet" href="/css/clientes.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body>

        <%- include('../partials/navbar.ejs') %>

        <div class="main-content">
            <div class="container py-5">
                <h1 class="mb-4">Administración de Usuarios y SOFOMES</h1>
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-body p-4">

                                <h2 class="mb-4">Nuevo Usuario</h2>

                                <% if (sofomes.length === 0) { %>
                                    <div class="alert alert-warning">Primero debes registrar una SOFOM</div>
                                <% } else { %>

                                    <form action="/users/create" method="POST">
                                        <div class="mb-3"><input type="text" name="nombre" class="form-control" placeholder="Nombre" required></div>
                                        <div class="mb-3"><input type="email" name="correo_electronico" class="form-control" placeholder="Correo electrónico" required></div>
                                        <div class="mb-3"><input type="password" name="contrasena" class="form-control" placeholder="Contraseña" minlength="8" required></div>
                                        <div class="mb-3"><input type="password" name="confirmar_contrasena" class="form-control" placeholder="Confirmar contraseña" minlength="8" required></div>
                                        <div class="mb-3">
                                            <select name="rol_id" class="form-select" required>
                                                <option value="">Selecciona un rol</option>
                                                <% roles.forEach(rol => { %>
                                                    <option value="<%= rol.rol_id %>"><%= rol.descripcion %></option>
                                                <% }) %>
                                            </select>
                                        </div>

                                        <div class="mb-4">
                                            <select name="sofom_id" class="form-select" required>
                                                <option value="">Selecciona una SOFOM</option>
                                                <% sofomes.forEach(sofom => { %>
                                                    <option value="<%= sofom.sofom_id %>"><%= sofom.sofom_id %> - <%= sofom.razon_social %></option>
                                                <% }) %>
                                            </select>
                                        </div>

                                        <button type="submit" class="btn btn-expediente w-100">Crear usuario</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-body p-4">

                                <h2 class="mb-4">Nueva SOFOM</h2>
                                <form action="/sofomes/create" method="POST">
                                    <div class="mb-3"><input type="text" name="razon_social" class="form-control" placeholder="Razón social" required></div>
                                    <div class="mb-4">
                                        <select name="tipo_entidad_id" class="form-select" required>
                                            <option value="">Selecciona tipo entidad</option>
                                            <option value="0">Entidad No Regulada</option>
                                            <option value="1">Entidad Regulada</option>
                                        </select>
                                    </div>

                                    <button type="submit" class="btn btn-expediente w-100">Crear SOFOM</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer.ejs') %>

    </body>
</html>
