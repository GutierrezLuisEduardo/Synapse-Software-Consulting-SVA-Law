<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">
                <h1 class="page-title mb-4">SOFOM Registradas</h1>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="table-responsive tabla-container">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Razón Social</th>
                                <th>Tipo Entidad</th>
                                <th>Usuarios</th>
                                <th>Estatus</th>
                                <th>Fecha Alta</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (sofomes.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-4">No hay SOFOM registradas</td>
                                </tr>
                            <% } %>
                            <% sofomes.forEach(sofom => { %>
                                <tr class="fila-cliente" onclick="window.location='/sofomes/<%= sofom.sofom_id %>'">
                                    <td><%= sofom.sofom_id %></td>
                                    <td><%= sofom.razon_social %></td>
                                    <td><%= sofom.tipo_entidad || sofom.tipo_entidad_id %></td>
                                    <td><%= sofom.total_usuarios %></td>
                                    <td>
                                        <span class="badge-estatus <%= sofom.estatus ? 'activo' : 'inactivo' %>">
                                            <%= sofom.estatus ? 'Activa' : 'Inactiva' %>
                                        </span>
                                    </td>
                                    <td><%= new Date(sofom.fecha_creacion).toLocaleDateString('es-MX') %></td>
                                    <td><span class="badge-expediente">Ver detalle</span></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </body>
</html>