<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="clientes-header mb-4">
                    <h1 class="page-title">Operaciones</h1>
                    <span class="text-muted" style="font-size:0.9rem;">
                        Mostrando hasta 50 registros por página
                    </span>
                </div>

                <div class="table-responsive tabla-container">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID Operación</th>
                                <th>ID Contrato</th>
                                <th>Cliente</th>
                                <th>Monto</th>
                                <th>Instrumento</th>
                                <th>Origen Recursos</th>
                                <th>Pago Excedido</th>
                                <th>Fecha</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (operaciones.length === 0) { %>
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        No se encontraron operaciones registradas
                                    </td>
                                </tr>
                            <% } %>
                            <% operaciones.forEach(op => { %>
                                <tr class="fila-cliente"
                                    onclick="window.location='/operaciones/<%= op.operacion_id %>'">
                                    <td><%= op.operacion_id %></td>
                                    <td><%= op.contrato_id %></td>
                                    <td><%= op.nombre_cliente || '—' %></td>
                                    <td>
                                        $<%= parseFloat(op.monto).toLocaleString('es-MX', {
                                            minimumFractionDigits: 2
                                        }) %>
                                    </td>
                                    <td><%= op.instrumento_monetario || '—' %></td>
                                    <td><%= op.origen_recursos || '—' %></td>
                                    <td><%= op.pago_excedido || '—' %></td>
                                    <td>
                                        <%= new Date(op.emision_operacion)
                                            .toLocaleDateString('es-MX') %>
                                    </td>
                                    <td>
                                        <span class="badge-expediente">Ver detalle</span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="pagination-container mt-4">
                    <div class="d-flex gap-2 align-items-center">
                        <% if (currentPage > 1) { %>
                            <a class="btn btn-pagination"
                               href="/operaciones?page=<%= currentPage - 1 %>">
                               Anterior
                            </a>
                        <% } %>
                        <span class="page-indicator">
                            Página <%= currentPage %> de <%= totalPages || 1 %>
                        </span>
                        <% if (currentPage < totalPages) { %>
                            <a class="btn btn-pagination"
                               href="/operaciones?page=<%= currentPage + 1 %>">
                               Siguiente
                            </a>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>
    </body>
</html>