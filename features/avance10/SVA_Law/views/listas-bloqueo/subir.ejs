<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/documentos.css">
        <style>
            .lista-badge {
                font-size: 0.75rem;
                padding: 0.3rem 0.65rem;
                border-radius: 99px;
                font-weight: 500;
            }
            .table-listas th {
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #6c757d;
                border-bottom: 2px solid #dee2e6;
            }
            .table-listas td {
                vertical-align: middle;
                font-size: 0.9rem;
            }
        </style>
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <h1 class="page-title mb-1">Listas de Bloqueo</h1>
                <p class="text-muted mb-4">
                    Carga/actualiza las listas de personas bloqueadas en formato <strong>.txt</strong>.
                    El texto se normalizará automáticamente (minúsculas, sin acentos ni caracteres especiales).
                </p>

                <% if (!puedeSubir) { %>
                    <div class="alert alert-warning mb-4">
                        Sólo el Administrador u Oficial de Cumplimiento pueden subir listas. Estás en modo lectura.
                    </div>
                <% } %>

                <% if (locals.error) { %>
                    <div class="alert alert-danger mb-4"><%= error %></div>
                <% } %>
                <% if (locals.exito) { %>
                    <div class="alert alert-success mb-4"><%= exito %></div>
                <% } %>

                <!-- ── Formulario de subida ───────────────────────── -->
                <div class="exp-card mb-5">
                    <h5 class="fw-semibold mb-4">Subir nueva lista</h5>

                    <!-- Tipo de lista -->
                    <div class="mb-4">
                        <label for="selectTipoOrigen" class="form-label fw-semibold">
                            Tipo de lista <span class="text-danger">*</span>
                        </label>
                        <select
                            id="selectTipoOrigen"
                            class="form-select"
                            <%= !puedeSubir ? 'disabled' : '' %>
                            required
                        >
                            <option value="">Seleccionar...</option>
                            <% tiposOrigen.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.descripcion %></option>
                            <% }) %>
                        </select>
                        <div class="form-text">
                            Si ya existe una lista de este tipo, será reemplazada por el nuevo archivo.
                        </div>
                    </div>

                    <!-- Drop zone -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Archivo <code>.txt</code> <span class="text-danger">*</span>
                        </label>
                        <div class="doc-drop-zone" id="dropZone">
                            <p class="doc-drop-text mb-2">Arrastra el archivo .txt aquí o haz clic en el botón</p>
                            <button
                                type="button"
                                class="btn-doc-select"
                                id="btnSeleccionar"
                                <%= !puedeSubir ? 'disabled' : '' %>
                            >
                                Seleccionar archivo
                            </button>
                            <input type="file" id="inputArchivo" accept=".txt,text/plain" style="display:none">
                            <div id="archivoInfo" class="doc-file-name mt-3" style="display:none">
                                <span id="nombreArchivo"></span>
                                <button type="button" class="doc-remove-btn" id="btnQuitar">✕</button>
                            </div>
                        </div>
                        <div class="form-text">Tamaño máximo: 5 MB.</div>
                    </div>

                    <!-- Botón subir -->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn-expediente px-5" id="btnSubir" disabled>
                            <span id="btnSubirTexto">Cargar lista</span>
                            <span
                                id="btnSubirSpinner"
                                class="spinner-border spinner-border-sm ms-2"
                                style="display:none"
                                role="status"
                            ></span>
                        </button>
                    </div>
                </div>

                <div class="exp-card">
                    <h5 class="fw-semibold mb-4">Listas registradas</h5>

                    <% if (listas.length === 0) { %>
                        <p class="text-muted">Aún no se han cargado listas de bloqueo para esta SOFOM.</p>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-listas table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Tipo</th>
                                        <th>Caracteres</th>
                                        <th>Última actualización</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% listas.forEach(l => { %>
                                        <tr>
                                            <td><span class="text-muted">#<%= l.lista_id %></span></td>
                                            <td>
                                                <span class="badge bg-secondary lista-badge">
                                                    <%= l.tipo_descripcion %>
                                                </span>
                                            </td>
                                            <td><%= parseInt(l.caracteres).toLocaleString('es-MX') %></td>
                                            <td>
                                                <%= l.ultima_actualizacion
                                                    ? new Date(l.ultima_actualizacion).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' })
                                                    : '—' %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>

        <script>
            const puedeSubir = <%= puedeSubir %>;

            if (puedeSubir) {
                const selectTipo    = document.getElementById('selectTipoOrigen');
                const dropZone      = document.getElementById('dropZone');
                const btnSeleccionar = document.getElementById('btnSeleccionar');
                const inputArchivo  = document.getElementById('inputArchivo');
                const archivoInfo   = document.getElementById('archivoInfo');
                const nombreArchivo = document.getElementById('nombreArchivo');
                const btnQuitar     = document.getElementById('btnQuitar');
                const btnSubir      = document.getElementById('btnSubir');
                const btnSubirTexto = document.getElementById('btnSubirTexto');
                const btnSubirSpin  = document.getElementById('btnSubirSpinner');

                const state = { tipoId: null, archivo: null };

                // Selección de tipo
                selectTipo.addEventListener('change', () => {
                    state.tipoId = selectTipo.value ? parseInt(selectTipo.value) : null;
                    validar();
                });

                // Botón seleccionar
                btnSeleccionar.addEventListener('click', () => inputArchivo.click());

                // Input file
                inputArchivo.addEventListener('change', () => {
                    const f = inputArchivo.files[0];
                    if (f) setArchivo(f);
                });

                // Drag & drop
                dropZone.addEventListener('dragover', e => {
                    e.preventDefault();
                    dropZone.classList.add('doc-drop-active');
                });
                dropZone.addEventListener('dragleave', () => dropZone.classList.remove('doc-drop-active'));
                dropZone.addEventListener('drop', e => {
                    e.preventDefault();
                    dropZone.classList.remove('doc-drop-active');
                    const f = e.dataTransfer.files[0];
                    if (f && (f.type === 'text/plain' || f.name.endsWith('.txt'))) {
                        setArchivo(f);
                    } else {
                        alert('Solo se permiten archivos .txt.');
                    }
                });

                function setArchivo(file) {
                    if (!file.name.toLowerCase().endsWith('.txt') && file.type !== 'text/plain') {
                        alert('Solo se permiten archivos .txt.');
                        return;
                    }
                    if (file.size > 5 * 1024 * 1024) {
                        alert('El archivo supera el límite de 5 MB.');
                        return;
                    }
                    state.archivo = file;
                    nombreArchivo.textContent = file.name;
                    archivoInfo.style.display = 'flex';
                    validar();
                }

                btnQuitar.addEventListener('click', () => {
                    state.archivo = null;
                    inputArchivo.value = '';
                    archivoInfo.style.display = 'none';
                    validar();
                });

                function validar() {
                    btnSubir.disabled = !(state.tipoId && state.archivo);
                }

                // Envío vía fetch con FormData
                btnSubir.addEventListener('click', async () => {
                    if (!state.tipoId || !state.archivo) return;

                    btnSubirTexto.textContent = 'Cargando...';
                    btnSubirSpin.style.display = 'inline-block';
                    btnSubir.disabled = true;

                    const fd = new FormData();
                    fd.append('tipo_origen', state.tipoId);
                    fd.append('archivo', state.archivo);

                    try {
                        const resp = await fetch('/listas-bloqueo', {
                            method: 'POST',
                            body: fd
                        });

                        // El controlador siempre responde con una página renderizada;
                        // si el status es 2xx, recargamos para mostrar el mensaje de éxito.
                        if (resp.ok) {
                            window.location.reload();
                        } else {
                            const html = await resp.text();
                            // Extraer mensaje de error del HTML devuelto
                            const match = html.match(/class="alert alert-danger[^"]*"[^>]*>([\s\S]*?)<\/div>/);
                            alert(match ? match[1].trim() : 'Ocurrió un error. Intenta de nuevo.');
                            btnSubir.disabled = false;
                        }
                    } catch {
                        alert('Error de red. Intenta de nuevo.');
                        btnSubir.disabled = false;
                    } finally {
                        btnSubirTexto.textContent = 'Cargar lista';
                        btnSubirSpin.style.display = 'none';
                    }
                });
            }
        </script>
    </body>
</html>
