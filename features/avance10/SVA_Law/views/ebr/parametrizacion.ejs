<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/ebr.css">
        <style>

        </style>
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <h1 class="page-title mb-0">Parametrización EBR</h1>
                    <span class="badge-clasificacion"><%= sofom.razon_social %></span>
                </div>

                <p class="text-muted mb-4" style="font-size:.9rem;">
                    Define el peso de cada criterio del Enfoque Basado en Riesgo para esta SOFOM.
                    Los valores deben estar entre <strong>0</strong> y <strong>1</strong>.
                </p>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <form
                    action="/ebr/parametrizacion"
                    method="POST"
                    id="formEbr"
                    novalidate
                >
                    <input type="hidden" name="sofom_id" value="<%= sofom.sofom_id %>">

                    <div class="row g-4">
                        <% for (const [clasificacion, criterios] of Object.entries(grupos)) { %>
                        <div class="col-lg-6">
                            <div class="exp-card h-100">
                                <h2 class="ebr-section-title"><%= clasificacion %></h2>

                                <% criterios.forEach(c => { %>
                                <div class="ebr-criterio-row">
                                    <label
                                        class="ebr-label"
                                        for="peso_<%= c.id %>"
                                    >
                                        <span class="text-muted me-1" style="font-size:.78rem;">#<%= c.id %></span>
                                        <%= c.descripcion %>
                                    </label>
                                    <div class="ebr-input-wrap">
                                        <input
                                            type="number"
                                            id="peso_<%= c.id %>"
                                            name="peso_<%= c.id %>"
                                            class="form-control form-control-sm ebr-peso"
                                            value="<%= c.peso.toFixed(2) %>"
                                            min="0"
                                            max="1"
                                            step="0.01"
                                            required
                                        >
                                    </div>
                                </div>
                                <% }) %>

                                <p class="ebr-total mt-2">
                                    Suma:
                                    <strong class="total-<%= clasificacion.replace(/\s/g,'_') %>">
                                        <%= totales[clasificacion].toFixed(2) %>
                                    </strong>
                                </p>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Guardar cambios
                        </button>
                        <a href="/" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Actualiza la suma del grupo en tiempo real
            document.querySelectorAll('.ebr-peso').forEach(input => {
                input.addEventListener('input', recalcularTotales);
            });

            function recalcularTotales() {
                // Agrupa todos los inputs por su grupo padre (.exp-card)
                document.querySelectorAll('.exp-card').forEach(card => {
                    const inputs = card.querySelectorAll('.ebr-peso');
                    const totalEl = card.querySelector('[class^="total-"]');
                    if (!totalEl) return;

                    let suma = 0;
                    inputs.forEach(inp => {
                        const v = parseFloat(inp.value);
                        if (!isNaN(v)) suma += v;
                    });
                    totalEl.textContent = suma.toFixed(2);
                });
            }

            // Validación antes de enviar
            document.getElementById('formEbr').addEventListener('submit', function (e) {
                let valido = true;
                document.querySelectorAll('.ebr-peso').forEach(inp => {
                    const v = parseFloat(inp.value);
                    if (isNaN(v) || v < 0 || v > 1) {
                        inp.classList.add('is-invalid');
                        valido = false;
                    } else {
                        inp.classList.remove('is-invalid');
                    }
                });
                if (!valido) {
                    e.preventDefault();
                    alert('Todos los pesos deben ser valores entre 0 y 1.');
                }
            });
        </script>
    </body>
</html>
