<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head.ejs') %>
        <link rel="stylesheet" href="/css/clientes.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body>

        <%- include('../partials/navbar.ejs') %>

        <div class="main-content">
            <div class="container py-5">

                <h1 class="page-title mb-4">Administración de Usuarios</h1>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="row justify-content-center">
                    <div class="col-lg-5 col-md-7 col-sm-10">
                        <div class="card border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4">

                                <h2 class="mb-1">Nuevo Administrador</h2>
                                <p class="mb-4">
                                    Registra un administrador y asígnalo a una SOFOM.
                                </p>

                                <form action="/root/users/create-admin" method="POST">

                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">Nombre</label>
                                        <input type="text" name="nombre" class="form-control"
                                            placeholder="Nombre completo"
                                            value="<%= valores ? valores.nombre : '' %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">Correo electrónico</label>
                                        <input type="email" name="correo_electronico" class="form-control"
                                            placeholder="correo@ejemplo.com"
                                            value="<%= valores ? valores.correo_electronico : '' %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">Contraseña</label>
                                        <input type="password" name="contrasena" class="form-control"
                                            placeholder="Mínimo 8 caracteres" minlength="8" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">Confirmar contraseña</label>
                                        <input type="password" name="confirmar_contrasena" class="form-control"
                                            placeholder="Repite la contraseña" minlength="8" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">SOFOM</label>
                                        <select name="sofom_id" class="form-select" required>
                                            <option value="">Selecciona una SOFOM</option>
                                            <% sofoms.forEach(s => { %>
                                                <option value="<%= s.sofom_id %>"
                                                    <%= (valores && valores.sofom_id == s.sofom_id) ? 'selected' : '' %>>
                                                    <%= s.razon_social %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label" style="font-weight:600;">Rol</label>
                                        <select name="rol_id" class="form-select" required>
                                            <option value="">Selecciona un rol</option>
                                            <% roles.forEach(r => { %>
                                                <option value="<%= r.rol_id %>"
                                                    <%= (valores && valores.rol_id == r.rol_id) ? 'selected' : '' %>>
                                                    <%= r.descripcion %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <button type="submit" class="btn btn-expediente w-100"
                                        style="padding: 14px; font-size: 1.05rem; letter-spacing: 0.3px;">
                                        Crear Administrador
                                    </button>

                                </form>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer.ejs') %>

    </body>
</html>