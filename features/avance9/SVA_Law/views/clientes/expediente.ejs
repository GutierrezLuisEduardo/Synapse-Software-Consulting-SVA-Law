<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/expediente.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <a href="/clientes" class="btn btn-expediente btn-sm"> ⟵ </a>
                    <h1 class="page-title mb-0">Expediente: <%= cliente.razon_social %></h1>
                </div>

                <div class="exp-tabs" role="tablist">
                    <button class="exp-tab-btn active" onclick="showTab('tab-info', this)">
                        Información del Cliente
                    </button>
                    <button class="exp-tab-btn" onclick="showTab('tab-operaciones', this)">
                        Operaciones
                        <span class="tab-badge"><%= operaciones.length %></span>
                    </button>
                    <button class="exp-tab-btn" onclick="showTab('tab-alertas', this)">
                        Alertas
                        <span class="tab-badge"><%= alertas.length %></span>
                    </button>
                </div>

                <div id="tab-info" class="exp-tab-pane active">

                    <div class="row g-4 mb-4">
                        <div class="col-lg-7">
                            <div class="exp-card h-100">
                                <h2 class="exp-section-title">Datos Personales</h2>
                                <div class="datos-grid">
                                    <div class="dato-item">
                                        <span class="dato-label">ID</span>
                                        <span class="dato-valor"><%= cliente.cliente_id %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Nombre / Razón Social</span>
                                        <span class="dato-valor"><%= cliente.razon_social %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Tipo de Persona</span>
                                        <span class="dato-valor"><%= cliente.tipo_persona || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Teléfono</span>
                                        <span class="dato-valor"><%= cliente.telefono || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Correo electrónico</span>
                                        <span class="dato-valor"><%= cliente.correo_electronico || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">CURP</span>
                                        <span class="dato-valor"><%= cliente.curp || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">RFC</span>
                                        <span class="dato-valor"><%= cliente.rfc || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Género</span>
                                        <span class="dato-valor"><%= cliente.genero || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Fecha de nacimiento</span>
                                        <span class="dato-valor"><%= cliente.fecha_nacimiento ? new Date(cliente.fecha_nacimiento).toLocaleDateString('es-MX') : '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Domicilio</span>
                                        <span class="dato-valor"><%= cliente.domicilio || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Actividad Económica</span>
                                        <span class="dato-valor"><%= cliente.actividad_economica || '—' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">SOFOM</span>
                                        <span class="dato-valor"><%= cliente.sofom_nombre %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Alerta histórica</span>
                                        <span class="dato-valor"><%= cliente.estatus_alerta_historica ? 'Sí' : 'No' %></span>
                                    </div>
                                    <div class="dato-item">
                                        <span class="dato-label">Ha sido PEPS</span>
                                        <span class="dato-valor"><%= cliente.ha_sido_peps ? 'Sí' : 'No' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="exp-card h-100">
                                <h2 class="exp-section-title">Riesgo Final</h2>
                                <table class="tabla-riesgo">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Valor</th>
                                            <th>Ponderación</th>
                                            <th>Puntaje</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Clasificación de Cliente</td>
                                            <td>—</td>
                                            <td>30%</td>
                                            <td>—</td>
                                        </tr>
                                        <tr>
                                            <td>Clasificación de Monitoreo</td>
                                            <td>—</td>
                                            <td>70%</td>
                                            <td>—</td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr class="fila-total">
                                            <td colspan="3" class="text-end">Valor Total</td>
                                            <td class="celda-total">—</td>
                                        </tr>
                                        <tr class="fila-riesgo">
                                            <td colspan="3" class="text-end">RIESGO DETERMINADO</td>
                                            <td class="celda-riesgo">—</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="exp-card mb-4">
                        <h2 class="exp-section-title">Documentos</h2>
                        <% if (!documentos || documentos.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene documentos registrados.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>Tipo de Documento</th>
                                            <th>Fecha de Carga</th>
                                            <th>Archivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% documentos.forEach(doc => { %>
                                            <tr class="fila-cliente" style="cursor:pointer;"
                                                onclick="window.open('/documentos/ver?ruta=<%= encodeURIComponent(doc.referencia_archivo) %>', '_blank')">
                                                <td><%= doc.tipo_documento %></td>
                                                <td><%= new Date(doc.fecha_carga).toLocaleDateString('es-MX') %></td>
                                                <td><span class="link-documento">Ver documento</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>

                    <div class="exp-card">
                        <h2 class="exp-section-title">Contratos</h2>
                        <% if (contratos.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene contratos registrados.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Descripción</th>
                                            <th>Producto</th>
                                            <th>Canal</th>
                                            <th>Monto Total</th>
                                            <th>Monto Pagado</th>
                                            <th>Pagos (hechos/acordados)</th>
                                            <th>Inicio</th>
                                            <th>Fin</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% contratos.forEach(contrato => { %>
                                            <tr>
                                                <td><%= contrato.contrato_id %></td>
                                                <td><%= contrato.descripcion || '—' %></td>
                                                <td><%= contrato.producto || '—' %></td>
                                                <td><%= contrato.canal || '—' %></td>
                                                <td>$<%= parseFloat(contrato.monto_total_pago).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                                                <td>$<%= parseFloat(contrato.monto_pagado || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                                                <td><%= contrato.numero_pagos_hechos %> / <%= contrato.numero_pagos_acordados %></td>
                                                <td><%= contrato.fecha_inicio ? new Date(contrato.fecha_inicio).toLocaleDateString('es-MX') : '—' %></td>
                                                <td><%= contrato.fecha_finalizacion ? new Date(contrato.fecha_finalizacion).toLocaleDateString('es-MX') : '—' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>

                </div>

                <div id="tab-operaciones" class="exp-tab-pane">
                    <div class="exp-card">
                        <h2 class="exp-section-title">Operaciones de <%= cliente.razon_social %></h2>
                        <% if (operaciones.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene operaciones registradas.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID Operación</th>
                                            <th>ID Contrato</th>
                                            <th>Monto</th>
                                            <th>Instrumento</th>
                                            <th>Origen Recursos</th>
                                            <th>Pago Excedido</th>
                                            <th>Fecha</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% operaciones.forEach(op => { %>
                                            <tr class="fila-cliente"
                                                onclick="window.location='/operaciones/<%= op.operacion_id %>'"
                                                style="cursor:pointer;">
                                                <td><%= op.operacion_id %></td>
                                                <td><%= op.contrato_id %></td>
                                                <td>$<%= parseFloat(op.monto).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                                                <td><%= op.instrumento_monetario || '—' %></td>
                                                <td><%= op.origen_recursos || '—' %></td>
                                                <td><%= op.pago_excedido || '—' %></td>
                                                <td><%= new Date(op.emision_operacion).toLocaleDateString('es-MX') %></td>
                                                <td><span class="badge-expediente">Ver detalle</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div id="tab-alertas" class="exp-tab-pane">
                    <div class="exp-card">
                        <h2 class="exp-section-title">Alertas de <%= cliente.razon_social %></h2>
                        <% if (alertas.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene alertas registradas.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Tipo de alerta</th>
                                            <th>Tipo de reporte</th>
                                            <th>ID Operación</th>
                                            <th>Requiere dictamen</th>
                                            <th>Estado</th>
                                            <th>Fecha</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% alertas.forEach(alerta => { %>
                                            <tr class="fila-cliente"
                                                onclick="window.location='/alertas/<%= alerta.alerta_id %>'"
                                                style="cursor:pointer;">
                                                <td><%= alerta.alerta_id %></td>
                                                <td><%= alerta.tipo_alerta %></td>
                                                <td><%= alerta.tipo_reporte %></td>
                                                <td><%= alerta.operacion_id || '—' %></td>
                                                <td><%= alerta.requiere_dictamen ? 'Sí' : 'No' %></td>
                                                <td>
                                                    <% if (alerta.estado_revision) { %>
                                                        <span class="badge-expediente" style="background-color:#2e7d32;">Revisada</span>
                                                    <% } else { %>
                                                        <span class="badge-expediente" style="background-color:var(--red);">Pendiente</span>
                                                    <% } %>
                                                </td>
                                                <td><%= new Date(alerta.fecha_hora_alerta).toLocaleDateString('es-MX') %></td>
                                                <td><span class="badge-expediente">Ver detalle</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>

        <script>
            function showTab(tabId, btn) {
                document.querySelectorAll('.exp-tab-pane').forEach(p => p.classList.remove('active'));
                document.querySelectorAll('.exp-tab-btn').forEach(b => b.classList.remove('active'));
                document.getElementById(tabId).classList.add('active');
                btn.classList.add('active');
            }
        </script>
    </body>
</html>