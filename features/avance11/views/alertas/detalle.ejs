<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/expediente.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <a href="/alertas" class="btn btn-expediente" style="width:auto; padding: 8px 18px;">
                        ← Volver
                    </a>
                    <h1 class="page-title mb-0">Detalle de Alerta #<%= alerta.alerta_id %></h1>
                </div>

                <div class="row g-4">

                    <div class="col-lg-6">
                        <div class="expediente-card h-100">
                            <h5 class="mb-4" style="font-weight:700; border-bottom: 2px solid var(--light); padding-bottom:12px;">
                                Información de la alerta
                            </h5>
                            <div class="cliente-info">
                                <p><strong>ID:</strong> <%= alerta.alerta_id %></p>
                                <p><strong>Tipo de alerta:</strong> <%= alerta.tipo_alerta %></p>
                                <p><strong>Tipo de reporte:</strong> <%= alerta.tipo_reporte %></p>
                                <p><strong>Descripción:</strong> <%= alerta.descripcion_alerta || '—' %></p>
                                <p><strong>ID Operación relacionada:</strong> <%= alerta.operacion_id || '—' %></p>
                                <p><strong>Requiere dictamen:</strong> <%= alerta.requiere_dictamen ? 'Sí' : 'No' %></p>
                                <% if (alerta.requiere_dictamen) { %>
                                    <p><strong>Plazo para dictamen:</strong> <%= alerta.dias_hasta_dictamen %> días</p>
                                <% } %>
                                <p><strong>Fecha de alerta:</strong>
                                    <%= new Date(alerta.fecha_hora_alerta).toLocaleString('es-MX') %>
                                </p>
                                <p><strong>Estado:</strong>
                                    <% if (alerta.estado_revision) { %>
                                        <span class="badge-expediente" style="background-color: #2e7d32;">Revisada</span>
                                    <% } else { %>
                                        <span class="badge-expediente" style="background-color: var(--red);">Pendiente</span>
                                    <% } %>
                                </p>

                                <% if (alerta.tipo_alerta_id == 3 && alerta.estado_revision) { %>
                                    <p><strong>Dictamen:</strong>
                                        <% if (alerta.esta_aprobado) { %>
                                            <span class="badge-expediente" style="background-color: #2e7d32;">Aprobada</span>
                                        <% } else { %>
                                            <span class="badge-expediente" style="background-color: var(--red);">Rechazada</span>
                                        <% } %>
                                    </p>
                                    <% if (alerta.descripcion_alerta) { %>
                                        <p><strong>Observaciones:</strong> <%= alerta.descripcion_alerta %></p>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Reporte asociado -->
                    <div class="col-lg-6">
                        <div class="expediente-card h-100">
                            <h5 class="mb-4" style="font-weight:700; border-bottom: 2px solid var(--light); padding-bottom:12px;">Reporte generado</h5>
                            <% if (reporte) { %>
                                <div class="cliente-info">
                                    <p><strong>ID Reporte:</strong> <%= reporte.reporte_id %></p>
                                    <p><strong>Tipo:</strong> <%= reporte.tipo_reporte %></p>
                                    <p><strong>Fecha de generación:</strong>
                                        <%= new Date(reporte.fecha_generacion).toLocaleString('es-MX') %>
                                    </p>
                                    <p><strong>Asunto:</strong> <%= reporte.asunto %></p>
                                    <p><strong>Descripción:</strong> <%= reporte.descripcion %></p>
                                    <% if (reporte.evidencia) { %>
                                        <p><strong>Evidencia:</strong>
                                            <a href="/reportes/evidencia?ruta=<%= encodeURIComponent(reporte.evidencia) %>"
                                            target="_blank" class="btn btn-sm btn-outline-secondary">
                                                Descargar evidencia
                                            </a>
                                        </p>
                                    <% } %>
                                    <% if (reporte.dias_restantes_dictamen !== null && reporte.dias_restantes_dictamen !== undefined) { %>
                                        <p><strong>Días restantes para dictamen:</strong>
                                            <span style="font-weight:700; color: #db6300">
                                                <%= reporte.dias_restantes_dictamen %>
                                            </span>
                                        </p>
                                    <% } %>
                                    <p><strong>Dictamen emitido:</strong> <%= reporte.dictamen_emitido ? 'Sí' : 'No' %></p>
                                    <p><strong>Descargado:</strong> <%= reporte.ha_sido_descargado ? 'Sí' : 'No' %></p>
                                    <% if (reporte.plazo_dictamen) { %>
                                        <p><strong>Plazo de dictamen:</strong>
                                            <%= new Date(reporte.plazo_dictamen).toLocaleDateString('es-MX') %>
                                        </p>
                                    <% } %>
                                    <% if (reporte.dictamen) { %>
                                        <p><strong>Dictamen del reporte:</strong> <%= reporte.dictamen %></p>
                                    <% } else { %>
                                        <p class="text-muted" style="font-size:0.9rem;">Sin dictamen de reporte emitido aún.</p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <p class="text-muted" style="font-size:0.9rem;">
                                    Esta alerta no tiene un reporte asociado todavía.
                                </p>
                            <% } %>
                        </div>
                    </div>

                    <% if (alerta.tipo_alerta_id == 3) { %>
                    <div class="col-12 mt-2">
                        <div class="expediente-card">
                            <h5 class="mb-3" style="font-weight:700; border-bottom:2px solid var(--light); padding-bottom:12px;">
                                Dictamen de la alerta
                            </h5>

                            <% if (puedeEmitirDictamen) { %>
                                <% if (alerta.estado_revision) { %>
                                    <div class="alert <%= alerta.esta_aprobado ? 'alert-success' : 'alert-danger' %> mb-3" role="alert">
                                        <strong>Dictamen actual:</strong>
                                        <%= alerta.esta_aprobado ? ' Aprobada' : ' Rechazada' %>
                                        — Puedes modificarlo a continuación.
                                    </div>
                                <% } %>

                                <form action="/alertas/<%= alerta.alerta_id %>/dictamen" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">
                                            Observaciones <span class="text-muted fw-normal">(opcional)</span>
                                        </label>
                                        <textarea
                                            name="descripcion_dictamen"
                                            class="form-control"
                                            rows="3"
                                            placeholder="Escribe las observaciones o justificación del dictamen..."
                                        ><%= alerta.descripcion_alerta || '' %></textarea>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="submit" name="accion" value="aprobar"
                                            class="btn btn-success px-4"> Aprobar </button>
                                        <button type="submit" name="accion" value="rechazar"
                                            class="btn btn-danger px-4"> Rechazar </button>
                                    </div>
                                </form>

                            <% } else { %>
                                <% if (alerta.estado_revision) { %>
                                    <div class="alert <%= alerta.esta_aprobado ? 'alert-success' : 'alert-danger' %>" role="alert">
                                        <strong>Resultado:</strong>
                                        <%= alerta.esta_aprobado ? ' Aprobada' : ' Rechazada' %>
                                    </div>
                                    <% if (alerta.descripcion_alerta) { %>
                                        <p><strong>Observaciones:</strong> <%= alerta.descripcion_alerta %></p>
                                    <% } %>
                                <% } else { %>
                                    <p class="text-muted" style="font-size:0.9rem;">
                                        Aún no se ha emitido un dictamen para esta alerta.
                                    </p>
                                <% } %>
                            <% } %>

                        </div>
                    </div>
                    <% } %>

                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </body>
</html>