<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/documentos.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <h1 class="page-title mb-1">Subida de Documentos</h1>
                <p class="text-muted mb-4">Asocia archivos PDF al expediente de un cliente.</p>

                <% if (!puedeSubir) { %>
                    <div class="alert alert-warning mb-4">
                        Solo el Oficial de Cumplimiento, Administrador o Empleado pueden subir documentos. Estás en modo lectura.
                    </div>
                <% } %>

                <% if (locals.error) { %>
                    <div class="alert alert-danger mb-4"><%= error %></div>
                <% } %>
                <% if (locals.exito) { %>
                    <div class="alert alert-success mb-4"><%= exito %></div>
                <% } %>

                <div class="exp-card">

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tipo de Persona <span class="text-danger">*</span></label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="tipo_persona_radio"
                                    id="radioFisica"
                                    value="1"
                                    checked
                                    <%= !puedeSubir ? 'disabled' : '' %>
                                >
                                <label class="form-check-label" for="radioFisica">Persona Física</label>
                            </div>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="tipo_persona_radio"
                                    id="radioMoral"
                                    value="0"
                                    <%= !puedeSubir ? 'disabled' : '' %>
                                >
                                <label class="form-check-label" for="radioMoral">Persona Moral</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="selectTipoDocumento" class="form-label fw-semibold">
                            Tipo de Documento <span class="text-danger">*</span>
                        </label>
                        <select id="selectTipoDocumento" class="form-select" <%= !puedeSubir ? 'disabled' : '' %> required>
                            <option value="">Seleccionar...</option>
                            <% tiposDocumento.forEach(td => { %>
                                <option
                                    value="<%= td.tipo_documento_id %>"
                                    data-tipo-persona="<%= td.tipo_persona_id %>"
                                >
                                    <%= td.descripcion %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="inputClienteId" class="form-label fw-semibold">
                            ID del Cliente <span class="text-danger">*</span>
                        </label>
                        <input
                            type="number"
                            id="inputClienteId"
                            class="form-control"
                            placeholder="Ej. 1042"
                            min="1"
                            <%= !puedeSubir ? 'disabled' : '' %>
                            required
                        >
                        <div id="clienteStatus" class="form-text mt-1"></div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Archivo PDF <span class="text-danger">*</span>
                        </label>
                        <div class="doc-drop-zone" id="dropZone">
                            <p class="doc-drop-text mb-2">Arrastra el PDF aquí o haz clic en el botón</p>
                            <button type="button" class="btn-doc-select" id="btnSeleccionarArchivo"
                                <%= !puedeSubir ? 'disabled' : '' %>>
                                Seleccionar archivo
                            </button>
                            <input
                                type="file"
                                id="inputArchivo"
                                accept="application/pdf"
                                style="display:none"
                            >
                            <div id="archivoSeleccionado" class="doc-file-name mt-3" style="display:none">
                                <span id="nombreArchivo"></span>
                                <button type="button" class="doc-remove-btn" id="btnQuitarArchivo">✕</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn-expediente px-5" id="btnSubir" disabled>
                            <span id="btnSubirTexto">Subir documento</span>
                            <span id="btnSubirSpinner" class="spinner-border spinner-border-sm ms-2" style="display:none" role="status"></span>
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>

        <script>
            const puedeSubir = '<%= puedeSubir %>' === 'true';

            const state = {
                tipoPersonaId: 1,
                tipoDocumentoId: null,
                clienteId: null,
                archivo: null
            };

            const radios         = document.querySelectorAll('input[name="tipo_persona_radio"]');
            const selectTipo     = document.getElementById('selectTipoDocumento');
            const inputCliente   = document.getElementById('inputClienteId');
            const clienteStatus  = document.getElementById('clienteStatus');
            const dropZone       = document.getElementById('dropZone');
            const btnSeleccionar = document.getElementById('btnSeleccionarArchivo');
            const inputArchivo   = document.getElementById('inputArchivo');
            const archivoInfo    = document.getElementById('archivoSeleccionado');
            const nombreArchivo  = document.getElementById('nombreArchivo');
            const btnQuitarArch  = document.getElementById('btnQuitarArchivo');
            const btnSubir       = document.getElementById('btnSubir');
            const btnSubirTexto  = document.getElementById('btnSubirTexto');
            const btnSubirSpin   = document.getElementById('btnSubirSpinner');

            if (!puedeSubir) {
                if (dropZone) dropZone.style.opacity = '0.6';
            } else {

                function filtrarTiposDocumento() {
                    const tipoSeleccionado = state.tipoPersonaId.toString();
                    Array.from(selectTipo.options).forEach(opt => {
                        if (!opt.value) return;
                        const pertenece = opt.dataset.tipoPersona === tipoSeleccionado;
                        opt.hidden = !pertenece;
                    });
                    const opcionActiva = selectTipo.options[selectTipo.selectedIndex];
                    if (opcionActiva && opcionActiva.value && opcionActiva.dataset.tipoPersona !== tipoSeleccionado) {
                        selectTipo.value = '';
                        state.tipoDocumentoId = null;
                    }
                    validarFormulario();
                }

                radios.forEach(radio => {
                    radio.addEventListener('change', () => {
                        state.tipoPersonaId = parseInt(radio.value);
                        filtrarTiposDocumento();
                    });
                });

                selectTipo.addEventListener('change', () => {
                    state.tipoDocumentoId = selectTipo.value ? parseInt(selectTipo.value) : null;
                    validarFormulario();
                });

                let debounceTimer;
                inputCliente.addEventListener('input', () => {
                    clearTimeout(debounceTimer);
                    const val = inputCliente.value.trim();
                    state.clienteId = val ? parseInt(val) : null;

                    if (!val) {
                        clienteStatus.textContent = '';
                        clienteStatus.className = 'form-text mt-1';
                        validarFormulario();
                        return;
                    }

                    if (isNaN(state.clienteId) || state.clienteId < 1) {
                        clienteStatus.textContent = 'Ingresa un ID de cliente válido.';
                        clienteStatus.className = 'form-text mt-1 text-danger';
                        state.clienteId = null;
                        validarFormulario();
                        return;
                    }

                    debounceTimer = setTimeout(async () => {
                        clienteStatus.textContent = 'Verificando cliente...';
                        clienteStatus.className = 'form-text mt-1 text-muted';
                        try {
                            const resp = await fetch(`/clientes/${state.clienteId}/verificar`);
                            const json = await resp.json();
                            if (json.existe) {
                                clienteStatus.textContent = `✓ Cliente encontrado: ${json.nombre}`;
                                clienteStatus.className = 'form-text mt-1 text-success';
                            } else {
                                clienteStatus.textContent = 'Cliente no encontrado en esta SOFOM.';
                                clienteStatus.className = 'form-text mt-1 text-danger';
                                state.clienteId = null;
                            }
                        } catch {
                            clienteStatus.textContent = 'Error al verificar cliente.';
                            clienteStatus.className = 'form-text mt-1 text-danger';
                            state.clienteId = null;
                        }
                        validarFormulario();
                    }, 500);
                });

                btnSeleccionar.addEventListener('click', () => inputArchivo.click());

                inputArchivo.addEventListener('change', () => {
                    const file = inputArchivo.files[0];
                    if (file) setArchivo(file);
                });

                dropZone.addEventListener('dragover', e => {
                    e.preventDefault();
                    dropZone.classList.add('doc-drop-active');
                });
                dropZone.addEventListener('dragleave', () => dropZone.classList.remove('doc-drop-active'));
                dropZone.addEventListener('drop', e => {
                    e.preventDefault();
                    dropZone.classList.remove('doc-drop-active');
                    const file = e.dataTransfer.files[0];
                    if (file && file.type === 'application/pdf') {
                        setArchivo(file);
                    } else {
                        alert('Solo se permiten archivos PDF.');
                    }
                });

                function setArchivo(file) {
                    if (file.type !== 'application/pdf') {
                        alert('Solo se permiten archivos PDF.');
                        return;
                    }
                    state.archivo = file;
                    nombreArchivo.textContent = file.name;
                    archivoInfo.style.display = 'flex';
                    validarFormulario();
                }

                btnQuitarArch.addEventListener('click', () => {
                    state.archivo = null;
                    inputArchivo.value = '';
                    archivoInfo.style.display = 'none';
                    validarFormulario();
                });

                function validarFormulario() {
                    const listo = state.tipoDocumentoId && state.clienteId && state.archivo;
                    btnSubir.disabled = !listo;
                }

                btnSubir.addEventListener('click', async () => {
                    if (!state.tipoDocumentoId || !state.clienteId || !state.archivo) return;

                    btnSubirTexto.textContent = 'Subiendo...';
                    btnSubirSpin.style.display = 'inline-block';
                    btnSubir.disabled = true;

                    const formData = new FormData();
                    formData.append('tipo_documento_id', state.tipoDocumentoId);
                    formData.append('cliente_id', state.clienteId);
                    formData.append('archivo', state.archivo);

                    try {
                        const resp = await fetch('/documentos/subir', {
                            method: 'POST',
                            body: formData
                        });
                        const json = await resp.json();

                        if (resp.ok && json.exito) {
                            mostrarAlerta('success', json.mensaje || 'Documento subido correctamente.');
                            resetFormulario();
                        } else {
                            mostrarAlerta('danger', json.error || 'Ocurrió un error al subir el documento.');
                            btnSubir.disabled = false;
                        }
                    } catch {
                        mostrarAlerta('danger', 'Error de red. Intenta de nuevo.');
                        btnSubir.disabled = false;
                    } finally {
                        btnSubirTexto.textContent = 'Subir documento';
                        btnSubirSpin.style.display = 'none';
                    }
                });

                function mostrarAlerta(tipo, mensaje) {
                    document.querySelectorAll('.alerta-dinamica').forEach(el => el.remove());
                    const div = document.createElement('div');
                    div.className = `alert alert-${tipo} mb-4 alerta-dinamica`;
                    div.textContent = mensaje;
                    document.querySelector('.exp-card').insertAdjacentElement('beforebegin', div);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }

                function resetFormulario() {
                    selectTipo.value = '';
                    inputCliente.value = '';
                    clienteStatus.textContent = '';
                    clienteStatus.className = 'form-text mt-1';
                    state.tipoDocumentoId = null;
                    state.clienteId = null;
                    state.archivo = null;
                    inputArchivo.value = '';
                    archivoInfo.style.display = 'none';
                    validarFormulario();
                }

                filtrarTiposDocumento();
            }
        </script>
    </body>
</html>