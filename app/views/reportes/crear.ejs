<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/documentos.css">
        <link rel="stylesheet" href="/css/reportes.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <h1 class="page-title mb-0">Nuevo Reporte ROIP</h1>
                </div>

                <%
                    // Solo mostrar si el rol es Oficial de cumplimiento, Admin o Empleado
                    const rolesPermitidos = ['Oficial de cumplimiento', 'Administrador', 'Empleado', 'Auditor'];
                    const puedeCrear = rolesPermitidos.includes(usuario.rol);
                %>

                <% if (!puedeCrear) { %>
                    <div class="alert alert-danger">No tienes permiso para crear reportes ROIP.</div>
                <% } else { %>
                    
                    <% if (locals.error) { %>
                        <div class="alert alert-danger mb-4"><%= error %></div>
                    <% } %>
                    
                    <% if (locals.exito) { %>
                        <div class="alert alert-success mb-4">
                            <strong>✓ Éxito:</strong> <%= exito %>
                        </div>
                    <% } %>

                <form action="/reportes/crear" method="POST" id="form-roip">

                    <div class="roip-card">
                        <h2 class="roip-title">Reporte de Operaciones Internas Propias (ROIP)</h2>
                        <p class="roip-subtitle">
                            Este reporte quedará registrado y generará una alerta en el sistema.
                        </p>

                        <% if (tipoROIP && tipoROIP.dias_hasta_dictamen) { %>
                            <div class="roip-plazo">
                                🕐 Plazo para emitir dictamen:
                                <strong><%= tipoROIP.dias_hasta_dictamen %> días hábiles</strong>
                                a partir de hoy.
                            </div>
                        <% } %>

                        <form
                            action="/reportes/crear"
                            method="POST"
                            enctype="multipart/form-data"
                            id="form-roip"
                        >
                            <!-- Asunto -->
                            <div class="mb-4">
                                <label class="roip-label" for="asunto">Asunto</label>
                                <input
                                    type="text"
                                    id="asunto"
                                    name="asunto"
                                    class="form-control"
                                    placeholder="Describe brevemente el motivo del reporte"
                                    maxlength="255"
                                    value="<%= valores ? valores.asunto : '' %>"
                                    required
                                >
                            </div>

                            <!-- Descripción -->
                            <div class="mb-4">
                                <label class="roip-label" for="descripcion">Descripción</label>
                                <textarea
                                    id="descripcion"
                                    name="descripcion"
                                    class="form-control"
                                    rows="6"
                                    placeholder="Detalla los hechos, operaciones o situaciones que motivan este reporte..."
                                    required
                                ><%= valores ? valores.descripcion : '' %></textarea>
                            </div>

                            <!-- Evidencia (opcional) -->
                            <div class="mb-4">
                                <label class="roip-label">Evidencia (PDF — opcional)</label>
                                <div
                                    class="upload-zone"
                                    id="upload-zone"
                                    onclick="document.getElementById('evidencia').click()"
                                >
                                    <p>Haz clic o arrastra un PDF aquí</p>
                                    <p class="file-name" id="file-name-display" style="display:none;"></p>
                                </div>
                                <input
                                    type="file"
                                    id="evidencia"
                                    name="evidencia"
                                    accept="application/pdf"
                                    style="display:none;"
                                >
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex justify-content-end gap-3 mt-2">
                                <a href="/alertas" class="btn btn-secondary px-4">Cancelar</a>
                                <button
                                    type="submit"
                                    class="btn-roip-submit"
                                    id="btn-submit"
                                >
                                    Enviar Reporte
                                </button>
                            </div>

                        </form>
                    </div>

                <% } %>

            </div>
        </div>

        <%- include('../partials/footer') %>

        <script>
            // ── Mostrar nombre del archivo seleccionado ─────────────────────
            const inputFile      = document.getElementById('evidencia');
            const fileNameDisplay = document.getElementById('file-name-display');
            const uploadZone     = document.getElementById('upload-zone');

            inputFile.addEventListener('change', () => {
                if (inputFile.files.length > 0) {
                    fileNameDisplay.textContent = '📄 ' + inputFile.files[0].name;
                    fileNameDisplay.style.display = 'block';
                } else {
                    fileNameDisplay.style.display = 'none';
                }
            });

            // ── Drag & drop ─────────────────────────────────────────────────
            uploadZone.addEventListener('dragover', e => {
                e.preventDefault();
                uploadZone.classList.add('drag-over');
            });

            uploadZone.addEventListener('dragleave', () => {
                uploadZone.classList.remove('drag-over');
            });

            uploadZone.addEventListener('drop', e => {
                e.preventDefault();
                uploadZone.classList.remove('drag-over');
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    const f = files[0];
                    if (f.type !== 'application/pdf') {
                        alert('Solo se permiten archivos PDF.');
                        return;
                    }
                    // Asignar el archivo al input
                    const dt = new DataTransfer();
                    dt.items.add(f);
                    inputFile.files = dt.files;
                    fileNameDisplay.textContent = '📄 ' + f.name;
                    fileNameDisplay.style.display = 'block';
                }
            });

            // ── Deshabilitar botón mientras se envía ────────────────────────
            document.getElementById('form-roip').addEventListener('submit', () => {
                const btn = document.getElementById('btn-submit');
                btn.disabled = true;
                btn.textContent = 'Enviando...';
            });
        </script>
    </body>
</html>
