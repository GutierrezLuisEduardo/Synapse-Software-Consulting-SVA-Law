<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
        <link rel="stylesheet" href="/css/expediente.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <a href="/clientes" class="btn btn-expediente btn-sm"> ⟵ </a>
                    <h1 class="page-title mb-0">Expediente: <%= cliente.razon_social %></h1>
                </div>

                <div class="exp-tabs" role="tablist">
                    <button class="exp-tab-btn active" onclick="showTab('tab-info', this)">
                        Información del Cliente
                    </button>
                    <button class="exp-tab-btn" onclick="showTab('tab-operaciones', this)">
                        Operaciones
                        <span class="tab-badge"><%= operaciones.length %></span>
                    </button>
                    <button class="exp-tab-btn" onclick="showTab('tab-alertas', this)">
                        Alertas
                        <span class="tab-badge"><%= alertas.length %></span>
                    </button>
                </div>

                <div id="tab-info" class="exp-tab-pane active">

                    <div class="exp-card h-100">
                        <form action="/clientes/<%= cliente.cliente_id %>/actualizar-perfil" method="POST">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="exp-section-title mb-0">Datos Personales</h2>
                                <button type="submit" class="btn btn-expediente btn-sm"
                                        data-testid="btn-guardar-perfil">
                                    Guardar cambios
                                </button>
                            </div>

                            <div class="datos-grid">
                                <div class="dato-item">
                                    <span class="dato-label">ID</span>
                                    <span class="dato-valor"><%= cliente.cliente_id %></span>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Puntaje de Riesgo</span>
                                    <span class="dato-valor celda-riesgo
                                        <%= cliente.riesgo_final === 1 ? 'riesgo-bajo'
                                        : cliente.riesgo_final === 2 ? 'riesgo-medio'
                                        : cliente.riesgo_final === 3 ? 'riesgo-alto'
                                        : '' %>">
                                        <%= cliente.riesgo_final === 1 ? 'BAJO'
                                        : cliente.riesgo_final === 2 ? 'MEDIO'
                                        : cliente.riesgo_final === 3 ? 'ALTO'
                                        : '—' %>
                                    </span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Nombre / Razón Social</span>
                                    <span class="dato-valor"><%= cliente.razon_social %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Tipo de Persona</span>
                                    <span class="dato-valor"><%= cliente.tipo_persona || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Teléfono</span>
                                    <span class="dato-valor"><%= cliente.telefono || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Correo electrónico</span>
                                    <span class="dato-valor"><%= cliente.correo_electronico || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">CURP</span>
                                    <span class="dato-valor"><%= cliente.curp || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">RFC</span>
                                    <span class="dato-valor"><%= cliente.rfc || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Género</span>
                                    <span class="dato-valor"><%= cliente.genero || '—' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Fecha de nacimiento</span>
                                    <span class="dato-valor">
                                        <%= cliente.fecha_nacimiento ? new Date(cliente.fecha_nacimiento).toLocaleDateString('es-MX') : '—' %>
                                    </span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">SOFOM</span>
                                    <span class="dato-valor"><%= cliente.sofom_nombre %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Alerta histórica</span>
                                    <span class="dato-valor"><%= cliente.estatus_alerta_historica ? 'Sí' : 'No' %></span>
                                </div>
                                <div class="dato-item">
                                    <span class="dato-label">Ha sido PEPS</span>
                                    <span class="dato-valor"><%= cliente.ha_sido_peps ? 'Sí' : 'No' %></span>
                                </div>


                                <div class="dato-item">
                                    <span class="dato-label">País de origen</span>
                                    <select name="pais_origen" class="form-select form-select-sm" data-testid="select-pais-origen">
                                        <% catalogos.paisOrigen.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.pais_origen_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Nacionalidad</span>
                                    <select name="nacionalidad" class="form-select form-select-sm" data-testid="select-nacionalidad">
                                        <% catalogos.nacionalidad.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.nacionalidad_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Domicilio</span>
                                    <select name="domicilio" class="form-select form-select-sm" data-testid="select-domicilio">
                                        <% catalogos.domicilio.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.domicilio_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Actividad Económica</span>
                                    <select name="actividad_economica" class="form-select form-select-sm" data-testid="select-actividad-economica">
                                        <% catalogos.actividadEconomica.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.actividad_economica_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Vinculado con grupo</span>
                                    <select name="vinculado_con_grupo" class="form-select form-select-sm" data-testid="select-vinculado-grupo">
                                        <% catalogos.vinculadoGrupo.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.vinculado_con_grupo_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Estado civil</span>
                                    <select name="estado_civil" class="form-select form-select-sm" data-testid="select-estado-civil">
                                        <% catalogos.estadoCivil.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.estado_civil_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Dependientes económicos</span>
                                    <select name="dependientes_economicos" class="form-select form-select-sm" data-testid="select-dependientes">
                                        <% catalogos.dependientesEconomicos.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.dependientes_economicos_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Número de hijos</span>
                                    <select name="numero_hijos" class="form-select form-select-sm" data-testid="select-numero-hijos">
                                        <% catalogos.numeroHijos.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.numero_hijos_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Nivel de estudios</span>
                                    <select name="nivel_estudios" class="form-select form-select-sm" data-testid="select-nivel-estudios">
                                        <% catalogos.nivelEstudios.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.nivel_estudios_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Tipo de vivienda</span>
                                    <select name="tipo_vivienda" class="form-select form-select-sm" data-testid="select-tipo-vivienda">
                                        <% catalogos.tipoVivienda.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.tipo_vivienda_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Tipo de empleo</span>
                                    <select name="tipo_empleo" class="form-select form-select-sm" data-testid="select-tipo-empleo">
                                        <% catalogos.tipoEmpleo.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.tipo_empleo_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Ingresos mensuales</span>
                                    <select name="ingresos_mensuales" class="form-select form-select-sm" data-testid="select-ingresos">
                                        <% catalogos.ingresosMensuales.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.ingresos_mensuales_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Valor del patrimonio</span>
                                    <select name="valor_patrimonio" class="form-select form-select-sm" data-testid="select-valor-patrimonio">
                                        <% catalogos.valorPatrimonio.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.valor_patrimonio_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Pertenece a partido político</span>
                                    <select name="pertenece_partido_politico" class="form-select form-select-sm" data-testid="select-partido">
                                        <% catalogos.pertenecePartido.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.pertenece_partido_politico_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">PEPS</span>
                                    <select name="peps" class="form-select form-select-sm" data-testid="select-peps">
                                        <option value="">— Sin asignar —</option>
                                        <% catalogos.peps.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.peps_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="dato-item">
                                    <span class="dato-label">Rango de edad</span>
                                    <select name="edad" class="form-select form-select-sm" data-testid="select-edad">
                                        <option value="">— Sin asignar —</option>
                                        <% catalogos.edad.forEach(op => { %>
                                            <option value="<%= op.id_opcion %>" <%= cliente.edad_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                        </form>
                    </div>

                    <br>

                    <div class="exp-card mb-4">
                        <h2 class="exp-section-title">Documentos</h2>
                        <% if (!documentos || documentos.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene documentos registrados.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>Canal</th>
                                            <th>Producto</th>
                                            <th>Finalidad</th>
                                            <th>Frecuencia</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% documentos.forEach(doc => { %>
                                            <tr class="fila-cliente" style="cursor:pointer;"
                                                onclick="window.open('/documentos/ver?ruta=<%= encodeURIComponent(doc.referencia_archivo) %>', '_blank')">
                                                <td><%= doc.tipo_documento %></td>
                                                <td><%= new Date(doc.fecha_carga).toLocaleDateString('es-MX') %></td>
                                                <td><span class="link-documento">Ver documento</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>

                    <div class="exp-card">
                        <h2 class="exp-section-title">Contratos</h2>
                        <% if (contratos.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene contratos registrados.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Descripción</th>
                                            <th>Canal</th>
                                            <th>Producto</th>
                                            <th>Finalidad</th>
                                            <th>Frecuencia de pago</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% contratos.forEach(contrato => { %>
                                            <tr data-testid="fila-contrato-<%= contrato.contrato_id %>">
                                                <td><%= contrato.contrato_id %></td>
                                                <td><%= contrato.descripcion || '—' %></td>

                                                <td>
                                                    <select name="canal"
                                                            form="form-contrato-<%= contrato.contrato_id %>"
                                                            class="form-select form-select-sm"
                                                            data-testid="select-canal-<%= contrato.contrato_id %>">
                                                        <% catalogosContrato.canales.forEach(op => { %>
                                                            <option value="<%= op.id_opcion %>" <%= contrato.canal_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                                        <% }) %>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select name="producto"
                                                            form="form-contrato-<%= contrato.contrato_id %>"
                                                            class="form-select form-select-sm"
                                                            data-testid="select-producto-<%= contrato.contrato_id %>">
                                                        <% catalogosContrato.productos.forEach(op => { %>
                                                            <option value="<%= op.id_opcion %>" <%= contrato.producto_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                                        <% }) %>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select name="finalidad_credito"
                                                            form="form-contrato-<%= contrato.contrato_id %>"
                                                            class="form-select form-select-sm"
                                                            data-testid="select-finalidad-<%= contrato.contrato_id %>">
                                                        <% catalogosContrato.finalidades.forEach(op => { %>
                                                            <option value="<%= op.id_opcion %>" <%= contrato.finalidad_credito_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                                        <% }) %>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select name="frecuencia_pago"
                                                            form="form-contrato-<%= contrato.contrato_id %>"
                                                            class="form-select form-select-sm"
                                                            data-testid="select-frecuencia-<%= contrato.contrato_id %>">
                                                        <% catalogosContrato.frecuenciasPago.forEach(op => { %>
                                                            <option value="<%= op.id_opcion %>" <%= contrato.frecuencia_pago_id == op.id_opcion ? 'selected' : '' %>><%= op.opciones %></option>
                                                        <% }) %>
                                                    </select>
                                                </td>

                                                <td>
                                                    <form id="form-contrato-<%= contrato.contrato_id %>"
                                                        action="/clientes/<%= cliente.cliente_id %>/actualizar-contrato"
                                                        method="POST">
                                                        <input type="hidden" name="contrato_id" value="<%= contrato.contrato_id %>">
                                                        <button type="submit" class="btn btn-expediente btn-sm"
                                                                data-testid="btn-guardar-contrato-<%= contrato.contrato_id %>">
                                                            Guardar
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>

                </div>

                <div id="tab-operaciones" class="exp-tab-pane">
                    <div class="exp-card">
                        <h2 class="exp-section-title">Operaciones de <%= cliente.razon_social %></h2>
                        <% if (operaciones.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene operaciones registradas.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID Operación</th>
                                            <th>ID Contrato</th>
                                            <th>Monto</th>
                                            <th>Instrumento</th>
                                            <th>Origen Recursos</th>
                                            <th>Pago Excedido</th>
                                            <th>Fecha</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% operaciones.forEach(op => { %>
                                            <tr class="fila-cliente"
                                                onclick="window.location='/operaciones/<%= op.operacion_id %>'"
                                                style="cursor:pointer;">
                                                <td><%= op.operacion_id %></td>
                                                <td><%= op.contrato_id %></td>
                                                <td>$<%= parseFloat(op.monto).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                                                <td><%= op.instrumento_monetario || '—' %></td>
                                                <td><%= op.origen_recursos || '—' %></td>
                                                <td><%= op.pago_excedido || '—' %></td>
                                                <td><%= new Date(op.emision_operacion).toLocaleDateString('es-MX') %></td>
                                                <td><span class="badge-expediente">Ver detalle</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div id="tab-alertas" class="exp-tab-pane">
                    <div class="exp-card">
                        <h2 class="exp-section-title">Alertas de <%= cliente.razon_social %></h2>
                        <% if (alertas.length === 0) { %>
                            <p class="sin-datos">Este cliente no tiene alertas registradas.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="tabla-exp">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Tipo de alerta</th>
                                            <th>Tipo de reporte</th>
                                            <th>ID Operación</th>
                                            <th>Requiere dictamen</th>
                                            <th>Estado</th>
                                            <th>Fecha</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% alertas.forEach(alerta => { %>
                                            <tr class="fila-cliente"
                                                onclick="window.location='/alertas/<%= alerta.alerta_id %>'"
                                                style="cursor:pointer;">
                                                <td><%= alerta.alerta_id %></td>
                                                <td><%= alerta.tipo_alerta %></td>
                                                <td><%= alerta.tipo_reporte %></td>
                                                <td><%= alerta.operacion_id || '—' %></td>
                                                <td><%= alerta.requiere_dictamen ? 'Sí' : 'No' %></td>
                                                <td>
                                                    <% if (alerta.estado_revision) { %>
                                                        <span class="badge-expediente" style="background-color:#2e7d32;">Revisada</span>
                                                    <% } else { %>
                                                        <span class="badge-expediente" style="background-color:var(--red);">Pendiente</span>
                                                    <% } %>
                                                </td>
                                                <td><%= new Date(alerta.fecha_hora_alerta).toLocaleDateString('es-MX') %></td>
                                                <td><span class="badge-expediente">Ver detalle</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>

        <script>
            function showTab(tabId, btn) {
                document.querySelectorAll('.exp-tab-pane').forEach(p => p.classList.remove('active'));
                document.querySelectorAll('.exp-tab-btn').forEach(b => b.classList.remove('active'));
                document.getElementById(tabId).classList.add('active');
                btn.classList.add('active');
            }
        </script>
    </body>
</html>