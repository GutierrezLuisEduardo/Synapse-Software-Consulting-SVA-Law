<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head.ejs') %>
        <link rel="stylesheet" href="/css/clientes.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body>

        <%- include('../partials/navbar.ejs') %>

        <div class="main-content">
            <div class="container py-5">

                <h1 class="page-title mb-4">Administración de SOFOMes</h1>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="row justify-content-center">
                    <div class="col-lg-5 col-md-7 col-sm-10">
                        <div class="card border-0 rounded-4 shadow-sm">
                            <div class="card-body p-4">

                                <h2 class="mb-1" style="font-weight:700;">Nueva SOFOM</h2>
                                <p class="mb-4" style="color:rgba(0,0,0,0.45); font-size:0.9rem;">
                                    Completa los campos para registrar una nueva entidad.
                                </p>

                                <form action="/sofomes/create" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label" style="font-weight:600;">Razón social</label>
                                        <input
                                            type="text"
                                            name="razon_social"
                                            class="form-control"
                                            placeholder="Ej. Financiera del Norte S.A. de C.V."
                                            required>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label" style="font-weight:600;">Tipo de entidad</label>
                                        <select name="tipo_entidad_id" class="form-select" required>
                                            <option value="">Selecciona un tipo</option>
                                            <% tiposEntidad.forEach(tipo => { %>
                                                <option value="<%= tipo.tipo_entidad_id %>"><%= tipo.descripcion %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <button type="submit" class="btn btn-expediente w-100" style="padding: 14px; font-size: 1.05rem; letter-spacing: 0.3px;">
                                        Registrar SOFOM
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer.ejs') %>

    </body>
</html>