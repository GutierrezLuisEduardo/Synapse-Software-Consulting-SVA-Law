<!DOCTYPE html>
<html>
    <head>
        <%- include('../partials/head') %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/clientes.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="main-content">
            <div class="container py-5">

                <div class="clientes-header mb-4">
                    <h1 class="page-title">Alertas</h1>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <%# Barra de filtros %>
                <form method="GET" action="/alertas" class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div>
                        <label class="form-label mb-1 fw-semibold" style="font-size:.8rem;">Tipo de alerta</label>
                        <select name="tipo_alerta_id" class="form-select form-select-sm">
                            <option value="">Todas</option>
                            <% tiposAlerta.forEach(t => { %>
                                <option value="<%= t.tipo_alerta_id %>"
                                    <%= filtros.tipo_alerta_id == t.tipo_alerta_id ? 'selected' : '' %>>
                                    <%= t.descripcion %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-1 fw-semibold" style="font-size:.8rem;">Tipo de reporte</label>
                        <select name="tipo_reporte_id" class="form-select form-select-sm">
                            <option value="">Todos</option>
                            <% tiposReporte.forEach(t => { %>
                                <% if (t.tipo_reporte_id === 3 && !esOficial) return; %>
                                <option value="<%= t.tipo_reporte_id %>"
                                    <%= filtros.tipo_reporte_id == t.tipo_reporte_id ? 'selected' : '' %>>
                                    <%= t.descripcion %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-expediente btn-sm">Filtrar</button>
                    <a href="/alertas" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </form>

                <%# Botones de exportación %>
                <div class="d-flex gap-2 mb-3">
                    <a href="/alertas/descargar-reportes" class="btn btn-expediente btn-sm">
                        Descargar reportes pendientes
                    </a>
                    <a href="/alertas/exportar/txt" class="btn btn-outline-secondary btn-sm">
                        Exportar historial de alertas
                    </a>
                </div>



                <div class="table-responsive tabla-container">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tipo de alerta</th>
                                <th>Tipo de reporte</th>
                                <th>ID Operación</th>
                                <th>Descripción</th>
                                <th>Requiere dictamen</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (alertas.length === 0) { %>
                                <tr>
                                    <td colspan="9" class="text-center py-4">No hay alertas registradas</td>
                                </tr>
                            <% } %>
                            <% alertas.forEach(alerta => { %>
                                <tr class="fila-cliente">
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer"><%= alerta.alerta_id %></td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer"><%= alerta.tipo_alerta %></td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer"><%= alerta.tipo_reporte %></td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer"><%= alerta.operacion_id || '—' %></td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer; max-width:200px; font-size:.85rem; color:#555;">
                                        <%= alerta.descripcion ? alerta.descripcion.slice(0,70) + (alerta.descripcion.length > 70 ? '…' : '') : '—' %>
                                    </td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer"><%= alerta.requiere_dictamen ? 'Sí' : 'No' %></td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer">
                                        <% if (alerta.estado_revision) { %>
                                            <span class="badge-expediente" style="background-color:#2e7d32;">Revisada</span>
                                        <% } else { %>
                                            <span class="badge-expediente" style="background-color:var(--red);">Pendiente</span>
                                        <% } %>
                                    </td>
                                    <td onclick="window.location='/alertas/<%= alerta.alerta_id %>'" style="cursor:pointer">
                                        <%= new Date(alerta.fecha_hora_alerta).toLocaleDateString('es-MX') %>
                                    </td>
                                    <td>
                                        <% if (!alerta.esta_aprobado && alerta.tipo_alerta_id == 3 && puedeEmitirDictamen) { %>
                                            <button class="btn btn-success btn-sm px-2 py-0"
                                                onclick="abrirModalDictamen(<%= alerta.alerta_id %>)"
                                                title="Emitir dictamen">
                                                Dictamen
                                            </button>
                                        <% } else { %>
                                            <a href="/alertas/<%= alerta.alerta_id %>" class="badge-expediente">Ver</a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>

                        <div class="modal fade" id="modalDictamen" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Emitir dictamen — Alerta #<span id="modalAlertaId"></span></h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form id="formDictamen" method="POST">
                                        <div class="modal-body">
                                            <label class="form-label fw-semibold">Descripción del dictamen</label>
                                            <textarea name="descripcion_dictamen" class="form-control" rows="3"
                                                placeholder="Escribe el dictamen..."></textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="submit" name="accion" value="aprobar" class="btn btn-success">Aprobar</button>
                                            <button type="submit" name="accion" value="rechazar" class="btn btn-danger">Rechazar</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <script>
                        function abrirModalDictamen(alertaId) {
                            document.getElementById('modalAlertaId').textContent = alertaId;
                            document.getElementById('formDictamen').action = `/alertas/${alertaId}/dictamen`;
                            new bootstrap.Modal(document.getElementById('modalDictamen')).show();
                        }
                        </script>

                    </table>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>
    </body>
</html>